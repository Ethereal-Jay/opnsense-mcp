OPNSENSE_URL=https://opnsense.example.com
OPNSENSE_API_KEY=replace-me
OPNSENSE_API_SECRET=replace-me

# disabled: read-only tools only; plan: describe writes but never execute; enabled: execute with a plan token
OPNSENSE_WRITE_MODE=disabled

# Prefer a trusted certificate or private CA. Never disable verification in production.
# OPNSENSE_CA_FILE=/absolute/path/to/opnsense-ca.pem
# OPNSENSE_TLS_VERIFY=true
# OPNSENSE_ALLOW_HTTP=false
# OPNSENSE_TIMEOUT_MS=30000
# OPNSENSE_MAX_RESPONSE_BYTES=2097152
